datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DriverStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  color       String   @default("blue") // 'emerald' | 'blue' | 'amber' | 'rose' | 'slate'
  isAvailable Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  drivers     Driver[]
}

model VehicleType {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  category          String   @default("Motor") // 'Motor' | 'Mobil Box' | 'Truk' | 'Pick-Up'
  maxWeightCapacity Float?   @default(0)
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  drivers           Driver[]
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  city      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivers   Driver[]
  orders    Order[]
}

model CargoType {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  category            String   @default("Standard") // 'Standard' | 'Dokumen' | 'Khusus' | 'Sensitif' | 'Makanan'
  handlingInstruction String?
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orders              Order[]
}

model Driver {
  id               String         @id
  name             String
  avatarUrl        String
  phone            String
  vehicleType      String
  plateNumber      String
  branch           String
  status           String
  startTime        String
  endTime          String
  notes            String         @default("")
  totalTasks       Int            @default(0)
  completedTasks   Int            @default(0)
  inProgressTasks  Int            @default(0)
  pendingTasks     Int            @default(0)
  cancelledTasks   Int            @default(0)
  onTimeRate       Float          @default(100.0)
  rating           Float          @default(5.0)
  performanceScore Int            @default(90)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  statusId         String?
  vehicleTypeId    String?
  branchId         String?

  driverStatusObj  DriverStatus?  @relation(fields: [statusId], references: [id], onDelete: SetNull)
  vehicleTypeObj   VehicleType?   @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)
  branchObj        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)

  orders           Order[]
  taskHistories    TaskHistory[]
}

model Order {
  id                 String     @id
  orderNumber        String     @unique
  customer           String
  pickupLocation     String
  dropoffLocation    String
  branch             String
  status             String
  assignedDriverId   String?
  assignedDriverName String?
  createdAt          DateTime   @default(now())
  targetDeliveryTime String     @default("Dalam 2 Jam")
  packageType        String     @default("Paket Reguler")
  priority           String     @default("Normal")
  notes              String?
  branchId           String?
  cargoTypeId        String?

  driver             Driver?    @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  branchObj          Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  cargoTypeObj       CargoType? @relation(fields: [cargoTypeId], references: [id], onDelete: SetNull)
}

model TaskHistory {
  id              String   @id
  orderNumber     String
  customer        String
  pickupLocation  String
  dropoffLocation String
  startTime       String
  endTime         String
  status          String
  notes           String?
  driverId        String
  createdAt       DateTime @default(now())

  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
}
