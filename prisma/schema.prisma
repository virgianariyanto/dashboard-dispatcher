datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DriverStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  color       String   @default("blue") // 'emerald' | 'blue' | 'amber' | 'rose' | 'slate'
  isAvailable Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  drivers     Driver[]
}

model SimType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String   @default("Kendaraan Ringan")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  drivers     Driver[]
}

model TaskType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
}

model Driver {
  id               String         @id
  nik              String?
  name             String
  avatarUrl        String
  phone            String
  simType          String         @default("SIM A")
  status           String
  startTime        String
  endTime          String
  notes            String         @default("")
  totalTasks       Int            @default(0)
  completedTasks   Int            @default(0)
  inProgressTasks  Int            @default(0)
  pendingTasks     Int            @default(0)
  cancelledTasks   Int            @default(0)
  onTimeRate       Float          @default(100.0)
  rating           Float          @default(5.0)
  performanceScore Int            @default(90)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  statusId         String?
  simTypeId        String?
  branchId         String?

  driverStatusObj  DriverStatus?  @relation(fields: [statusId], references: [id], onDelete: SetNull)
  simTypeObj       SimType?       @relation(fields: [simTypeId], references: [id], onDelete: SetNull)
  branchObj        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)

  orders           Order[]
  taskHistories    TaskHistory[]
}

model Branch {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  city        String
  address     String?
  phone       String?
  email       String?
  managerName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  drivers     Driver[]
  orders      Order[]
}

model Order {
  id                 String     @id
  orderNumber        String     @unique
  customer           String
  pickupLocation     String
  dropoffLocation    String
  status             String
  assignedDriverId   String?
  assignedDriverName String?
  createdAt          DateTime   @default(now())
  startDate          DateTime   @default(now())
  endDate            DateTime?
  targetDeliveryTime String     @default("Dalam 2 Jam")
  taskType           String     @default("Replace")
  priority           String     @default("Normal")
  notes              String?
  taskTypeId         String?
  branchId           String?

  driver             Driver?    @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  taskTypeObj        TaskType?  @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)
  branchObj          Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model TaskHistory {
  id              String   @id
  orderNumber     String
  customer        String
  pickupLocation  String
  dropoffLocation String
  startTime       String
  endTime         String
  status          String
  notes           String?
  driverId        String
  createdAt       DateTime @default(now())

  driver          Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  password  String
  name      String   @default("Administrator")
  role      String   @default("admin")
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

