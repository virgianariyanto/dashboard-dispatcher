{
  "name": "dashboard-dispatcher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:seed": "node --import tsx --env-file=.env.local prisma/seed.ts",
    "db:push:local": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:seed:local": "node --import tsx --env-file=.env.local prisma/seed.ts",
    "db:push:prod": "node --env-file=.env node_modules/prisma/build/index.js db push",
    "db:seed:prod": "node --import tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
